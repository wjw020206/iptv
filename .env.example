# 复制为 .env 后填写；.env 不会提交到 Git 或打入镜像。
DEPLOY_HOST=your-server-ip
DEPLOY_PORT=22
DEPLOY_USER=root
# 含 #、空格等字符时用单引号包裹；留空则使用 SSH 密钥 / Agent。
DEPLOY_PASSWORD='your-server-password'
# 服务器已有的 Compose 文件所在目录，保留原来的数据卷挂载。
DEPLOY_DIR=~/iptv
DEPLOY_SERVICE=iptv
DEPLOY_IMAGE=iptv:personal
# Intel / AMD 服务器使用 linux/amd64；ARM64 使用 linux/arm64。
DEPLOY_PLATFORM=linux/amd64
# 非 root 用户如需 sudo，须已配置免密码 sudo docker。
DEPLOY_SUDO=false
