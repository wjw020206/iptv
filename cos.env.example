# 复制为 cos.env，仅供 sync:cos 命令使用；不要提交真实密钥。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-shanghai
COS_KEY=iptv.m3u
# 可选：同名频道跨分组合并，一条 EXTINF 后连续输出多个地址。
COS_MERGE_LINES=false

# 本机订阅地址；如已设置访问密码，使用 /密码/interface.m3u。
# 也可使用 /u/用户令牌/interface.m3u，以及 ?profile=xxx&relay=1。
COS_SOURCE_URL=http://127.0.0.1:1905/你的访问密码/interface.m3u

# IPTV 服务器的公网地址，不是 COS 地址；不带访问密码或用户令牌。
# 服务器 IP 变化后修改这里，再次同步即可。
COS_PUBLIC_BASE_URL=http://你的服务器公网IP:1905
